NODE_ENV=production
# Set these to distinct, real numeric UIDs provisioned on this host.
TANUKI_WORKER_UID=REPLACE
TANUKI_API_UID=REPLACE
TANUKI_WORKER_DATA_DIR=/var/lib/tanuki-worker
TANUKI_WORKER_KEY_FILE=/etc/tanuki-worker/processing-key.asc
TANUKI_WORKER_TLS_KEY=/etc/tanuki-worker/tls.key
TANUKI_WORKER_TLS_CERT=/etc/tanuki-worker/tls.crt
TANUKI_WORKER_TLS_CA=/etc/tanuki-worker/client-ca.crt
TANUKI_WORKER_API_CERT_SHA256=REPLACE_WITH_PINNED_API_CLIENT_CERTIFICATE_SHA256
TANUKI_WORKER_PORT=3101
TANUKI_WORKER_PROVIDER_URL=https://api.openai.com/v1
TANUKI_WORKER_PROVIDER_KEY=
TANUKI_WORKER_MODEL=gpt-4o-mini
