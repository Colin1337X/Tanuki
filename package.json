{
  "name": "tanuki-stories",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch server/index.js",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "build": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 tests/node/*.test.js",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --experimental-test-coverage --test --test-concurrency=1 --test-coverage-include=server/** --test-coverage-include=worker/** --test-coverage-include=public/assets/pq-recipient.js --test-coverage-include=public/assets/app.js --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info tests/node/*.test.js",
    "keys:create": "node scripts/create-keys.js",
    "keys:rotate": "node --env-file-if-exists=.env.local scripts/rotate-keys.js",
    "crypto:benchmark": "node scripts/benchmark-crypto.js",
    "coverage:report": "node scripts/report-coverage.js",
    "data:upgrade": "node --env-file-if-exists=.env.local scripts/upgrade-data.js",
    "data:archive-legacy": "node --env-file-if-exists=.env.local scripts/archive-legacy.js",
    "crypto:benchmark:pq": "node scripts/benchmark-pq.mjs",
    "crypto:vendor": "node scripts/vendor-pq.mjs",
    "release:bundle": "node scripts/release/bundle.mjs",
    "release:archive": "node scripts/release/archive.mjs",
    "setup": "node installer/setup.mjs",
    "start:installed": "node installer/start.mjs",
    "tauri": "node clients/node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@node-rs/argon2": "^2.2.2",
    "hash-wasm": "4.12.0",
    "openpgp": "6.3.2"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
