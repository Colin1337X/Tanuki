# Production requires an HTTPS origin and a separate keyring.
NODE_ENV=production
APP_ORIGIN=https://stories.example.com
TANUKI_KEYRING_FILE=/secure/tanuki/keyring.json
TANUKI_DATA_DIR=./data
# First-start bootstrap only. Unique password, at least 12 characters.
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional additional provider origins approved by the server operator.
# AI_ALLOWED_ORIGINS=https://another-approved-provider.example
# Never set TANUKI_ALLOW_LEGACY_UPGRADE in the running service. Use data:upgrade offline.
# Disabled preview. Read docs/security/RECIPIENT_ENCRYPTION.md before isolated evaluation.
TANUKI_RECIPIENT_ENCRYPTION=0
# Opt-in, separate-UID worker deployment; see docs/security/TRUSTED_WORKER.md.
# Enable both flags only after provisioning and independently verifying worker identity.
TANUKI_TRUSTED_WORKER=0
# TANUKI_WORKER_URL=https://localhost:3101
# TANUKI_WORKER_CA=/etc/tanuki/worker-ca.crt
# TANUKI_WORKER_CLIENT_CERT=/etc/tanuki/worker-client.crt
# TANUKI_WORKER_CLIENT_KEY=/etc/tanuki/worker-client.key
# TANUKI_WORKER_FINGERPRINT=REPLACE_WITH_VERIFIED_64_HEX_FINGERPRINT
