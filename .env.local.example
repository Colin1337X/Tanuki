# Production requires an HTTPS origin and a separate keyring.
NODE_ENV=production
APP_ORIGIN=https://stories.example.com
TANUKI_KEYRING_FILE=/secure/tanuki/keyring.json
TANUKI_DATA_DIR=./data
# First-start bootstrap only. Unique password, at least 12 characters.
ADMIN_USERNAME=administrator
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional additional provider origins approved by the server operator.
# AI_ALLOWED_ORIGINS=https://another-approved-provider.example
# Never set TANUKI_ALLOW_LEGACY_UPGRADE in the running service. Use data:upgrade offline.
